---
const year = new Date().getFullYear();
---

<main class="page-shell">
	<article class="note" aria-labelledby="page-title">
		<div class="note-top">
			<p class="microtext" aria-hidden="true">
				Casa de cambio · Tasas de referencia · Casa de cambio · Tasas de
				referencia · Casa de cambio · Tasas de referencia ·
			</p>
			<p class="serial">No. 1 842 067 · Serie {year}</p>
		</div>

		<div class="note-body">
			<header class="note-intro">
				<div class="seal-mark" aria-hidden="true">MC</div>
				<h1 id="page-title">Mesa de cambio</h1>
				<p>
					Convierte entre monedas de América, Europa y Asia con la tasa
					vigente. Se actualizan cada minuto.
				</p>
			</header>

			<section class="converter" aria-labelledby="converter-title">
				<h2 id="converter-title" class="sr-only">Conversor de monedas</h2>

				<div class="field">
					<div class="field-head">
						<label for="from">Tengo</label>
						<div class="select-wrap">
							<input
								id="currency-from"
								class="combobox-input"
								type="text"
								role="combobox"
								autocomplete="off"
								spellcheck="false"
								aria-autocomplete="list"
								aria-expanded="false"
								aria-haspopup="listbox"
								aria-controls="currency-from-list"
								aria-describedby="currency-hint"
								aria-label="Moneda de origen"
							/>
							<svg viewBox="0 0 12 8" fill="none" aria-hidden="true">
								<path
									d="M1 1.5 6 6.5 11 1.5"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
							<ul
								id="currency-from-list"
								class="combobox-list"
								role="listbox"
								aria-label="Monedas disponibles"
								hidden>
							</ul>
						</div>
					</div>
					<p id="currency-hint" class="sr-only">
						Escribe el país o el código de la moneda para filtrar.
					</p>
					<input
						id="from"
						type="text"
						inputmode="decimal"
						autocomplete="off"
						placeholder="0.00"
						value="1"
					/>
				</div>

				<div class="swap-row">
					<span class="rule" aria-hidden="true"></span>
					<button
						id="swap-button"
						class="swap"
						type="button"
						aria-label="Intercambiar monedas"
					>
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="M7 4v16m0 0-3-3m3 3 3-3M17 20V4m0 0-3 3m3-3 3 3"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</button>
					<span class="rule" aria-hidden="true"></span>
				</div>

				<div class="field">
					<div class="field-head">
						<label for="to">Recibo</label>
						<div class="select-wrap">
							<input
								id="currency-to"
								class="combobox-input"
								type="text"
								role="combobox"
								autocomplete="off"
								spellcheck="false"
								aria-autocomplete="list"
								aria-expanded="false"
								aria-haspopup="listbox"
								aria-controls="currency-to-list"
								aria-describedby="currency-hint"
								aria-label="Moneda de destino"
							/>
							<svg viewBox="0 0 12 8" fill="none" aria-hidden="true">
								<path
									d="M1 1.5 6 6.5 11 1.5"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
							<ul
								id="currency-to-list"
								class="combobox-list"
								role="listbox"
								aria-label="Monedas disponibles"
								hidden>
							</ul>
						</div>
					</div>
					<output
						id="to"
						for="from currency-from currency-to"
						aria-live="polite"
						aria-atomic="true">—</output>
				</div>

				<p class="rate-line">
					<span>Tasa de referencia</span>
					<output id="rate-value" aria-live="polite">—</output>
				</p>
			</section>
		</div>

		<footer class="note-stub">
			<div class="status" data-state="loading">
				<span class="status-dot" aria-hidden="true"></span>
				<p id="status" role="status" aria-live="polite">Cargando tasas…</p>
			</div>

			<div class="refresh">
				<span class="countdown" id="countdown">60 s</span>
				<button
					id="force-refresh"
					class="refresh-button"
					type="button"
					data-loading="false"
				>
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M20 11a8 8 0 1 0-2.34 5.66M20 4v7h-7"
							stroke="currentColor"
							stroke-width="1.7"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
					Actualizar
				</button>
			</div>

			<span class="cache-bar" aria-hidden="true">
				<span id="cache-progress"></span>
			</span>
		</footer>
	</article>

	<section class="quotes-section" aria-labelledby="quotes-title">
		<div class="quotes-head">
			<div>
				<h2 id="quotes-title">Cotizaciones</h2>
				<p>Valor de cada moneda frente a 1 dólar estadounidense.</p>
			</div>
			<p class="quotes-base">Base: 1 USD</p>
		</div>
		<div id="quotes" class="quotes-groups"></div>
	</section>

	<footer class="page-footer">
		<p>
			Tasas de referencia de DuckDuckGo. No constituyen una oferta de cambio.
		</p>
		<p>Actualizadas automáticamente cada minuto.</p>
	</footer>
</main>

<script is:inline>
	const continents = [
		{ id: "america", label: "América" },
		{ id: "europa", label: "Europa" },
		{ id: "asia", label: "Asia" },
	];

	const currencyMetadata = {
		USD: {
			flag: "🇺🇸",
			name: "Dólar estadounidense",
			country: "Estados Unidos",
			continent: "america",
		},
		EUR: {
			flag: "🇪🇺",
			name: "Euro",
			country: "Unión Europea",
			continent: "europa",
		},
		COP: {
			flag: "🇨🇴",
			name: "Peso colombiano",
			country: "Colombia",
			continent: "america",
		},
		UYU: {
			flag: "🇺🇾",
			name: "Peso uruguayo",
			country: "Uruguay",
			continent: "america",
		},
		ARS: {
			flag: "🇦🇷",
			name: "Peso argentino",
			country: "Argentina",
			continent: "america",
		},
		CLP: {
			flag: "🇨🇱",
			name: "Peso chileno",
			country: "Chile",
			continent: "america",
		},
		CNY: {
			flag: "🇨🇳",
			name: "Yuan chino",
			country: "China",
			continent: "asia",
		},
		JPY: {
			flag: "🇯🇵",
			name: "Yen japonés",
			country: "Japón",
			continent: "asia",
		},
		PEN: {
			flag: "🇵🇪",
			name: "Sol peruano",
			country: "Perú",
			continent: "america",
		},
		MXN: {
			flag: "🇲🇽",
			name: "Peso mexicano",
			country: "México",
			continent: "america",
		},
	};

	const currencyCodes = Object.keys(currencyMetadata);
	const currencies = Object.fromEntries(
		currencyCodes.map((code) => [code, 0]),
	);

	const CACHE_SECONDS = 60;

	const $from = document.querySelector("#from");
	const $to = document.querySelector("#to");
	const $currencyFrom = document.querySelector("#currency-from");
	const $currencyTo = document.querySelector("#currency-to");
	const $currencyFromList = document.querySelector("#currency-from-list");
	const $currencyToList = document.querySelector("#currency-to-list");
	const $swapButton = document.querySelector("#swap-button");
	const $refreshButton = document.querySelector("#force-refresh");
	const $countdown = document.querySelector("#countdown");
	const $status = document.querySelector("#status");
	const $statusGroup = $status.closest(".status");
	const $rateValue = document.querySelector("#rate-value");
	const $cacheProgress = document.querySelector("#cache-progress");
	const $quotes = document.querySelector("#quotes");

	const quoteValues = new Map();
	let secondsLeft = CACHE_SECONDS;
	let countdownTimer;
	let isFetching = false;

	function formatAmount(value) {
		const abs = Math.abs(value);
		const decimals = abs > 0 && abs < 0.01 ? 6 : abs > 0 && abs < 1 ? 4 : 2;

		return value.toLocaleString("en-US", {
			minimumFractionDigits: decimals,
			maximumFractionDigits: decimals,
		});
	}

	function formatRate(value) {
		const abs = Math.abs(value);
		const decimals = abs >= 100 ? 2 : abs >= 1 ? 4 : 6;

		return value.toLocaleString("en-US", {
			minimumFractionDigits: abs >= 1 ? 2 : 6,
			maximumFractionDigits: decimals,
		});
	}

	function parseAmount(value) {
		const cleaned = String(value)
			.replace(/,/g, "")
			.replace(/[^0-9.]/g, "");

		if (!cleaned) return null;

		const parsed = Number.parseFloat(cleaned);
		return Number.isFinite(parsed) ? parsed : null;
	}

	function formatInputValue(value) {
		const cleaned = String(value).replace(/[^0-9.]/g, "");
		if (!cleaned) return "";

		const [integerPart, ...decimalParts] = cleaned.split(".");
		const normalizedInteger = (integerPart || "0").replace(
			/^0+(?=\d)/,
			"",
		);
		const decimals = decimalParts.join("").slice(0, 4);
		const formattedInteger = Number(
			normalizedInteger || "0",
		).toLocaleString("en-US");

		return decimals ? `${formattedInteger}.${decimals}` : formattedInteger;
	}

	function normalizeSearch(value) {
		return String(value)
			.normalize("NFD")
			.replace(/[\u0300-\u036f]/g, "")
			.toLowerCase()
			.trim();
	}

	const currencyIndex = currencyCodes.map((code) => {
		const metadata = currencyMetadata[code];
		return {
			code,
			haystack: normalizeSearch(
				`${code} ${metadata.name} ${metadata.country}`,
			),
		};
	});

	const LIST_GAP = 6;
	const LIST_MIN_WIDTH = 232;
	const LIST_MAX_HEIGHT = 320;

	function createCurrencyCombobox({ input, list, initialCode, onChange }) {
		const wrap = input.closest(".select-wrap");
		let selectedCode = initialCode;
		let results = [];
		let activeIndex = -1;
		let isOpen = false;

		function labelFor(code) {
			return `${currencyMetadata[code].flag} ${code}`;
		}

		function showLabel() {
			input.value = labelFor(selectedCode);
		}

		function positionList() {
			const rect = input.getBoundingClientRect();
			const width = Math.min(
				Math.max(rect.width, LIST_MIN_WIDTH),
				window.innerWidth - LIST_GAP * 2,
			);
			const below = window.innerHeight - rect.bottom - LIST_GAP * 2;
			const above = rect.top - LIST_GAP * 2;
			const openUp = below < 200 && above > below;

			list.style.width = `${width}px`;
			list.style.left = `${Math.min(
				Math.max(rect.left, LIST_GAP),
				window.innerWidth - width - LIST_GAP,
			)}px`;
			list.style.maxHeight = `${Math.min(
				LIST_MAX_HEIGHT,
				Math.max(160, openUp ? above : below),
			)}px`;
			list.style.top = openUp ? "auto" : `${rect.bottom + LIST_GAP}px`;
			list.style.bottom = openUp
				? `${window.innerHeight - rect.top + LIST_GAP}px`
				: "auto";
		}

		function setActive(index) {
			const options = list.querySelectorAll(".combobox-option");

			if (!options.length) {
				activeIndex = -1;
				input.removeAttribute("aria-activedescendant");
				return;
			}

			activeIndex = (index + options.length) % options.length;

			options.forEach((option, optionIndex) => {
				option.classList.toggle("is-active", optionIndex === activeIndex);
			});

			const active = options[activeIndex];
			input.setAttribute("aria-activedescendant", active.id);
			active.scrollIntoView({ block: "nearest" });
		}

		function render(query) {
			const term = normalizeSearch(query);
			results = term
				? currencyIndex.filter((entry) => entry.haystack.includes(term))
				: currencyIndex.slice();

			list.textContent = "";

			if (!results.length) {
				const empty = document.createElement("li");
				empty.className = "combobox-empty";
				empty.textContent = "Sin resultados";
				list.append(empty);
				setActive(-1);
				return;
			}

			results.forEach((entry, index) => {
				const metadata = currencyMetadata[entry.code];

				const option = document.createElement("li");
				option.id = `${input.id}-option-${index}`;
				option.className = "combobox-option";
				option.dataset.code = entry.code;
				option.setAttribute("role", "option");
				option.setAttribute(
					"aria-selected",
					String(entry.code === selectedCode),
				);

				const flag = document.createElement("span");
				flag.className = "combobox-option-flag";
				flag.setAttribute("aria-hidden", "true");
				flag.textContent = metadata.flag;

				const code = document.createElement("span");
				code.className = "combobox-option-code";
				code.textContent = entry.code;

				const name = document.createElement("span");
				name.className = "combobox-option-name";
				name.textContent = metadata.name;

				option.append(flag, code, name);
				list.append(option);
			});

			const selectedIndex = results.findIndex(
				(entry) => entry.code === selectedCode,
			);
			setActive(selectedIndex === -1 ? 0 : selectedIndex);
		}

		function open(query) {
			if (!isOpen) {
				isOpen = true;
				input.setAttribute("aria-expanded", "true");
				wrap.dataset.open = "true";
				list.hidden = false;
			}

			render(query);
			positionList();
		}

		function close() {
			if (!isOpen) return;

			isOpen = false;
			input.setAttribute("aria-expanded", "false");
			input.removeAttribute("aria-activedescendant");
			wrap.dataset.open = "false";
			list.hidden = true;
		}

		function commit(code) {
			if (!currencyMetadata[code]) return;

			selectedCode = code;
			showLabel();
			close();
			if (onChange) onChange(code);
		}

		input.addEventListener("focus", () => {
			input.select();
			open("");
		});

		input.addEventListener("input", () => {
			open(input.value);
		});

		input.addEventListener("click", () => {
			// Clicks should always select the whole label, so typing replaces it.
			if (input.value === labelFor(selectedCode)) input.select();
		});

		input.addEventListener("keydown", (event) => {
			const isArrow = event.key === "ArrowDown" || event.key === "ArrowUp";

			if (isArrow) {
				event.preventDefault();

				if (!isOpen) {
					open("");
					return;
				}

				setActive(activeIndex + (event.key === "ArrowDown" ? 1 : -1));
				return;
			}

			if (!isOpen) return;

			if (event.key === "Enter") {
				event.preventDefault();

				if (activeIndex >= 0 && results[activeIndex]) {
					commit(results[activeIndex].code);
				} else {
					showLabel();
					close();
				}
				return;
			}

			if (event.key === "Escape") {
				event.preventDefault();
				showLabel();
				close();
				return;
			}

			if (event.key === "Tab") {
				showLabel();
				close();
			}
		});

		input.addEventListener("blur", () => {
			showLabel();
			close();
		});

		list.addEventListener("mousedown", (event) => {
			// Keep the focus on the input so blur does not close the list first.
			event.preventDefault();
		});

		list.addEventListener("pointermove", (event) => {
			const option = event.target.closest(".combobox-option");
			if (!option) return;

			const index = results.findIndex(
				(entry) => entry.code === option.dataset.code,
			);
			if (index !== -1 && index !== activeIndex) setActive(index);
		});

		list.addEventListener("click", (event) => {
			const option = event.target.closest(".combobox-option");
			if (option) commit(option.dataset.code);
		});

		window.addEventListener("resize", () => {
			if (isOpen) positionList();
		});

		window.addEventListener(
			"scroll",
			() => {
				if (isOpen) positionList();
			},
			true,
		);

		showLabel();

		return {
			get value() {
				return selectedCode;
			},
			setCode(code) {
				if (!currencyMetadata[code]) return;

				selectedCode = code;
				showLabel();
				if (isOpen) render("");
			},
		};
	}

	function createQuoteItem(code) {
		const metadata = currencyMetadata[code];
		const item = document.createElement("li");

		const top = document.createElement("div");
		top.className = "quote-top";

		const flag = document.createElement("span");
		flag.className = "quote-flag";
		flag.textContent = metadata.flag;
		flag.setAttribute("aria-hidden", "true");

		const codeLabel = document.createElement("span");
		codeLabel.className = "quote-code";
		codeLabel.textContent = code;

		top.append(flag, codeLabel);

		const value = document.createElement("p");
		value.className = "quote-value";
		value.textContent = "—";

		const name = document.createElement("p");
		name.className = "quote-name";
		name.textContent = metadata.name;
		name.title = metadata.name;

		item.append(top, value, name);
		quoteValues.set(code, value);

		return item;
	}

	function buildQuotes() {
		continents.forEach((continent) => {
			const codes = currencyCodes.filter(
				(code) => currencyMetadata[code].continent === continent.id,
			);

			if (!codes.length) return;

			const group = document.createElement("section");
			group.className = "quote-group";
			group.setAttribute("aria-labelledby", `quotes-${continent.id}`);

			const title = document.createElement("h3");
			title.id = `quotes-${continent.id}`;
			title.className = "quote-group-title";

			const titleText = document.createElement("span");
			titleText.textContent = continent.label;

			const rule = document.createElement("span");
			rule.className = "quote-group-rule";
			rule.setAttribute("aria-hidden", "true");

			const count = document.createElement("span");
			count.className = "quote-group-count";
			count.textContent = String(codes.length);

			title.append(titleText, rule, count);

			const list = document.createElement("ul");
			list.className = "quotes";
			codes.forEach((code) => list.append(createQuoteItem(code)));

			group.append(title, list);
			$quotes.append(group);
		});
	}

	function updateQuotes() {
		currencyCodes.forEach((code) => {
			const value = quoteValues.get(code);
			if (!value) return;

			const rate = currencies[code];
			setText(value, rate > 0 ? formatAmount(rate) : "—");
		});
	}

	function setText(element, text) {
		if (element.textContent !== text) element.textContent = text;
	}

	function updateConversion() {
		const from = searchableFrom.value;
		const to = searchableTo.value;
		const fromRate = currencies[from];
		const toRate = currencies[to];

		if (!(fromRate > 0) || !(toRate > 0)) {
			setText($to, "—");
			$to.classList.add("is-empty");
			setText($rateValue, "Sin tasas disponibles");
			return;
		}

		const amount = parseAmount($from.value);
		$to.classList.toggle("is-empty", amount === null);

		if (amount === null) {
			setText($to, "—");
		} else {
			const result = from === to ? amount : (amount / fromRate) * toRate;
			setText($to, formatAmount(result));
		}

		setText(
			$rateValue,
			from === to
				? `1 ${from} = 1 ${to}`
				: `1 ${from} = ${formatRate(toRate / fromRate)} ${to}`,
		);
	}

	function setStatus(message, state) {
		$status.textContent = message;
		$statusGroup.dataset.state = state;
	}

	function setLoading(loading) {
		$refreshButton.disabled = loading;
		$refreshButton.dataset.loading = String(loading);
		$refreshButton.setAttribute("aria-busy", String(loading));
	}

	function renderCountdown() {
		$countdown.textContent = `${secondsLeft} s`;
		$cacheProgress.style.width = `${(secondsLeft / CACHE_SECONDS) * 100}%`;
	}

	function startCountdown() {
		clearInterval(countdownTimer);
		secondsLeft = CACHE_SECONDS;
		renderCountdown();

		countdownTimer = window.setInterval(() => {
			secondsLeft -= 1;

			if (secondsLeft <= 0) {
				secondsLeft = CACHE_SECONDS;
				getCurrenciesValues();
			}

			renderCountdown();
		}, 1000);
	}

	async function getCurrenciesValues(force = false) {
		if (isFetching) return;

		isFetching = true;
		setLoading(true);
		setStatus("Actualizando tasas…", "loading");

		try {
			const results = await Promise.allSettled(
				currencyCodes.map(async (code) => {
					const response = await fetch(
						`api/currency/${code}${force ? "?force=true" : ""}`,
					);

					if (!response.ok) {
						throw new Error(`HTTP ${response.status}`);
					}

					const data = await response.json();
					const mid = Number(data.mid);

					if (!Number.isFinite(mid) || mid <= 0) {
						throw new Error("Tasa inválida");
					}

					return { code, mid };
				}),
			);

			let updated = 0;

			results.forEach((result) => {
				if (result.status === "fulfilled") {
					currencies[result.value.code] = result.value.mid;
					updated += 1;
				}
			});

			updateQuotes();
			updateConversion();

			if (updated === currencyCodes.length) {
				const time = new Date().toLocaleTimeString("es", {
					hour: "2-digit",
					minute: "2-digit",
					hour12: false,
				});
				setStatus(`Actualizado a las ${time}`, "idle");
			} else if (updated > 0) {
				setStatus("Algunas tasas no se actualizaron", "warning");
			} else {
				setStatus("No se pudieron obtener las tasas", "error");
			}
		} catch (error) {
			console.error("No se pudieron obtener las tasas", error);
			setStatus("No se pudieron obtener las tasas", "error");
		} finally {
			isFetching = false;
			setLoading(false);
		}
	}

	const searchableFrom = createCurrencyCombobox({
		input: $currencyFrom,
		list: $currencyFromList,
		initialCode: "USD",
		onChange: updateConversion,
	});

	const searchableTo = createCurrencyCombobox({
		input: $currencyTo,
		list: $currencyToList,
		initialCode: "COP",
		onChange: updateConversion,
	});

	buildQuotes();

	updateConversion();
	startCountdown();
	getCurrenciesValues();

	$from.addEventListener("input", updateConversion);

	$from.addEventListener("blur", () => {
		const formatted = formatInputValue($from.value);
		if (formatted) $from.value = formatted;
		updateConversion();
	});

	$from.addEventListener("focus", () => {
		$from.value = $from.value.replace(/,/g, "");
	});

	$swapButton.addEventListener("click", () => {
		const fromCode = searchableFrom.value;
		const toCode = searchableTo.value;
		const received = $to.textContent;

		searchableFrom.setCode(toCode);
		searchableTo.setCode(fromCode);
		$from.value =
			received && received !== "—" ? received.replace(/,/g, "") : "";

		updateConversion();
	});

	$refreshButton.addEventListener("click", () => {
		secondsLeft = CACHE_SECONDS;
		renderCountdown();
		getCurrenciesValues(true);
	});
</script>
