---
import "@fontsource-variable/archivo";
import "@fontsource-variable/fraunces/full.css";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Mesa de cambio · Divisas",
	description = "Convierte entre monedas de América y Asia con tasas de referencia actualizadas cada minuto.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0d2a23" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
